package com.shivam.hedera;

import com.hedera.hashgraph.sdk.*;
import io.github.cdimascio.dotenv.Dotenv;

public class DeployEscrowContract {

    public static void main(String[] args) throws Exception {

        Dotenv env = Dotenv.load();
        AccountId operatorId = AccountId.fromString(env.get("OPERATOR_ID"));
        PrivateKey operatorKey = PrivateKey.fromString(env.get("OPERATOR_KEY"));

        Client client = Client.forTestnet();
        client.setOperator(operatorId, operatorKey);

        System.out.println("Deploying from Hedera Account: " + operatorId);
        System.out.println("Mirror EVM address: 0x" + operatorId.toSolidityAddress());

        // Bytecode copied from Remix
        String bytecodeHex = "";
        byte[] bytecode = hexStringToByteArray(bytecodeHex);
        // Create contract
        ContractCreateTransaction tx = new ContractCreateTransaction()
                .setBytecode(bytecode)
                .setGas(3_000_000)
                .setConstructorParameters(
                        new ContractFunctionParameters()
                                .addAddress(operatorId.toSolidityAddress()) // mirror owner
                );

        TransactionResponse response = tx.execute(client);
        TransactionReceipt receipt = response.getReceipt(client);

        ContractId contractId = receipt.contractId;

        System.out.println("Contract deployed!");
        System.out.println("Contract ID: " + contractId);
        System.out.println("Contract EVM: " + contractId.toSolidityAddress());
    }
    
    private static byte[] hexStringToByteArray(String s) {
        int len = s.length();
        if (len % 2 != 0) {
            throw new IllegalArgumentException("Hex string must have even length");
        }

        byte[] data = new byte[len / 2];
        for (int i = 0; i < len; i += 2) {
            data[i / 2] = (byte) (
                    (Character.digit(s.charAt(i), 16) << 4)
                            + Character.digit(s.charAt(i + 1), 16)
            );
        }
        return data;
    }

}
