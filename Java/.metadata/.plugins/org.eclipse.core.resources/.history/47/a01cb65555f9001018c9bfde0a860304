package com.shivam.hedera;

import com.hedera.hashgraph.sdk.*;
import io.github.cdimascio.dotenv.Dotenv;
import java.time.Duration;
import java.time.Instant;

public class TokenAssociation {
    public static void main(String[] args) throws Exception {

        Dotenv dotenv = Dotenv.load();
        AccountId operatorId = AccountId.fromString(dotenv.get("OPERATOR_ID"));
        PrivateKey operatorKey = PrivateKey.fromString(dotenv.get("OPERATOR_KEY"));

        Client client = Client.forTestnet();
        client.setOperator(operatorId, operatorKey);
        
        // ✅ Add request timeout and retries
        client.setRequestTimeout(Duration.ofSeconds(60));
        client.setMaxAttempts(5);

        ContractId contractId = ContractId.fromString("0.0.7728370");
        TokenId tokenId = TokenId.fromString("0.0.6460709");

        System.out.println("Associating contract " + contractId + " with token " + tokenId);

        // ✅ Create transaction with time buffer
        TransactionId txId = new TransactionId(
            operatorId,
            Instant.now().minusSeconds(3)  // 3 second buffer
        );

        ContractExecuteTransaction tx = new ContractExecuteTransaction()
            .setTransactionId(txId)
            .setContractId(contractId)
            .setGas(2_000_000)
            .setFunction(
                "associateNewToken",
                new ContractFunctionParameters()
                    .addAddress(tokenId.toSolidityAddress())
            )
            .setTransactionValidDuration(Duration.ofSeconds(120))
            .setMaxTransactionFee(new Hbar(2))
            .freezeWith(client)
            .sign(operatorKey);

        TransactionResponse resp = tx.execute(client);
        System.out.println("✅ Submitted TxId: " + resp.transactionId);

        TransactionReceipt receipt = resp.getReceipt(client);
        System.out.println("Status: " + receipt.status);
        
        if (receipt.status == Status.SUCCESS) {
            System.out.println("✅ Contract successfully associated with token!");
        } else {
            System.out.println("❌ Association failed: " + receipt.status);
        }
    }
}
